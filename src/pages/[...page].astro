---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection('posts');
  posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const pageTitle =
  page.currentPage === 1 ? 'Статьи' : `Статьи - страница ${page.currentPage}`;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('ru-RU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(date);

const pageLink = (pageNumber: number) =>
  pageNumber === 1 ? '/' : `/${pageNumber}/`;

const getPaginationItems = (currentPage: number, lastPage: number) => {
  const pages = new Set<number>([1, lastPage]);
  const start = Math.max(1, currentPage - 2);
  const end = Math.min(lastPage, currentPage + 2);

  for (let pageNumber = start; pageNumber <= end; pageNumber += 1) {
    pages.add(pageNumber);
  }

  const sortedPages = [...pages].sort((a, b) => a - b);
  const items: Array<number | 'ellipsis'> = [];

  for (let index = 0; index < sortedPages.length; index += 1) {
    const pageNumber = sortedPages[index];
    const previousPage = sortedPages[index - 1];

    if (previousPage && pageNumber - previousPage > 1) {
      items.push('ellipsis');
    }

    items.push(pageNumber);
  }

  return items;
};

const paginationItems = getPaginationItems(page.currentPage, page.lastPage);
---

<Layout title={pageTitle}>
  <section class="feed-list" aria-label="Список статей">
    {
      page.data.map((post) => (
        <article class="post-card">
          {post.data.cover && (
            <a
              class="post-card__cover-link"
              href={`/posts/${post.data.postSlug}/`}
            >
              <img
                class="post-card__cover"
                src={post.data.cover}
                alt={post.data.coverAlt ?? post.data.title}
                loading="lazy"
              />
            </a>
          )}
          <div class="post-card__body">
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <h2>
              <a href={`/posts/${post.data.postSlug}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.excerpt}</p>
            <a
              class="post-card__read-more"
              href={`/posts/${post.data.postSlug}/`}
            >
              Читать статью
            </a>
          </div>
        </article>
      ))
    }
  </section>

  {
    page.lastPage > 1 && (
      <nav class="pagination" aria-label="Пагинация статей">
        <a
          class:list={['pagination__item', !page.url.prev && 'is-disabled']}
          href={page.url.prev ?? undefined}
          aria-disabled={!page.url.prev}
        >
          &lt;
        </a>

        <div class="pagination__list">
          {paginationItems.map((item) =>
            item === 'ellipsis' ? (
              <span class="pagination__ellipsis" aria-hidden="true">
                ···
              </span>
            ) : (
              <a
                class:list={[
                  'pagination__item',
                  page.currentPage === item && 'is-active'
                ]}
                href={pageLink(item)}
                aria-current={page.currentPage === item ? 'page' : undefined}
              >
                {item}
              </a>
            )
          )}
        </div>

        <a
          class:list={['pagination__item', !page.url.next && 'is-disabled']}
          href={page.url.next ?? undefined}
          aria-disabled={!page.url.next}
        >
          &gt;
        </a>
      </nav>
    )
  }
</Layout>

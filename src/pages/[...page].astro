---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import {
  resolvePostPath,
  resolvePostTransitionName
} from '../lib/resolve-post-slugs';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection('posts');
  posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const pageTitle =
  page.currentPage === 1
    ? 'Статьи | Блог Михаила Реммеле'
    : `Статьи - страница ${page.currentPage} | Блог Михаила Реммеле`;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('ru-RU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(date);

const pageLink = (pageNumber: number) =>
  pageNumber === 1 ? '/' : `/${pageNumber}/`;

const isMobileHiddenItem = (
  currentPage: number,
  lastPage: number,
  item: number
): boolean => {
  return (
    (currentPage - 2 === item || currentPage + 2 === item) &&
    item !== 0 &&
    item !== lastPage
  );
};

const getPaginationItems = (currentPage: number, lastPage: number) => {
  const pages = new Set<number>([1, lastPage]);
  const start = Math.max(1, currentPage - 2);
  const end = Math.min(lastPage, currentPage + 2);

  for (let pageNumber = start; pageNumber <= end; pageNumber += 1) {
    pages.add(pageNumber);
  }

  const sortedPages = [...pages].sort((a, b) => a - b);
  const items: Array<number | 'ellipsis'> = [];

  for (let index = 0; index < sortedPages.length; index += 1) {
    const pageNumber = sortedPages[index];
    const previousPage = sortedPages[index - 1];

    if (previousPage && pageNumber - previousPage > 1) {
      items.push('ellipsis');
    }

    items.push(pageNumber);
  }

  return items;
};

const paginationItems = getPaginationItems(page.currentPage, page.lastPage);
---

<Layout title={pageTitle}>
  <section class="feed-list" aria-label="Список статей">
    {
      page.data.map((post) => {
        const postPath = resolvePostPath(post);
        const transitionBase = resolvePostTransitionName(post);
        return (
          <article class="post-card">
            {post.data.cover && (
              <a class="post-card__cover-link" href={postPath}>
                <img
                  class="post-card__cover"
                  src={post.data.cover}
                  alt={post.data.coverAlt ?? post.data.title}
                  loading="lazy"
                />
              </a>
            )}
            <div class="post-card__body">
              <time
                datetime={post.data.date.toISOString()}
                transition:name={`${transitionBase}-date`}
              >
                {formatDate(post.data.date)}
              </time>
              <h2 transition:name={`${transitionBase}-title`}>
                <a href={postPath}>{post.data.title}</a>
              </h2>
              <p>{post.data.excerpt}</p>
              <a class="post-card__read-more" href={postPath}>
                Читать статью
              </a>
            </div>
          </article>
        );
      })
    }
  </section>

  {
    page.lastPage > 1 && (
      <nav class="pagination" aria-label="Пагинация статей">
        <a
          class:list={[
            'pagination__item',
            'is-arrow',
            !page.url.prev && 'is-disabled'
          ]}
          href={page.url.prev ?? undefined}
          aria-disabled={!page.url.prev}
        >
          &lt;
        </a>

        <div class="pagination__list">
          {paginationItems.map((item) =>
            item === 'ellipsis' ? (
              <span class="pagination__ellipsis" aria-hidden="true">
                ···
              </span>
            ) : (
              <a
                class:list={[
                  'pagination__item',
                  page.currentPage === item && 'is-active',
                  isMobileHiddenItem(page.currentPage, page.lastPage, item) &&
                    'is-mobile-hidden'
                ]}
                href={pageLink(item)}
                aria-current={page.currentPage === item ? 'page' : undefined}
              >
                {item}
              </a>
            )
          )}
        </div>

        <a
          class:list={[
            'pagination__item',
            'is-arrow',
            !page.url.next && 'is-disabled'
          ]}
          href={page.url.next ?? undefined}
          aria-disabled={!page.url.next}
        >
          &gt;
        </a>
      </nav>
    )
  }
</Layout>

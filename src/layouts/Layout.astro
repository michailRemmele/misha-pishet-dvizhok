---
import '../styles/globals.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/700.css';
import interFont400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import interFont700 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  socialType?: 'website' | 'article';
  noIndex?: boolean;
}

const {
  title,
  description = 'Рассказываю о ходе разработки игрового движка, который я пишу в свободное от работы время.',
  socialType = 'website',
  noIndex = false
} = Astro.props;
const currentYear = new Date().getFullYear();
const siteUrl = Astro.site;
const pageUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl) : undefined;

const resolveImageUrl = (image: string) => {
  try {
    return new URL(image).toString();
  } catch {
    return siteUrl ? new URL(image, siteUrl).toString() : image;
  }
};

const imageUrl = resolveImageUrl('/social-preview.png');
const twitterCard = imageUrl ? 'summary_large_image' : 'summary';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={socialType} />
    <meta property="og:site_name" content="Миша пишет движок" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl.toString()} />}
    {pageUrl && <link rel="canonical" href={pageUrl.toString()} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interFont400}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interFont700}
      crossorigin
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-title" href="/">
          <span>Миша</span>
          <span class="site-title__chip">пишет движок</span>
        </a>
        <div class="theme-switcher" role="group" aria-label="Выбор темы">
          <button
            class="theme-switcher__button"
            type="button"
            data-theme-option="light"
            aria-label="Светлая тема"
            title="Светлая тема"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="none"
              viewBox="0 0 16 16"
              ><path
                fill="currentColor"
                fill-rule="evenodd"
                d="M8 3a.75.75 0 0 1-.75-.75V.75a.75.75 0 0 1 1.5 0v1.5A.75.75 0 0 1 8 3m0 7.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8m-.75 3.25a.75.75 0 0 0 1.5 0v-1.5a.75.75 0 0 0-1.5 0zM13 8a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5h-1.5A.75.75 0 0 1 13 8M.75 7.25a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5zm10.786-2.786a.75.75 0 0 1 0-1.06l1.06-1.06a.75.75 0 0 1 1.06 1.06l-1.06 1.06a.75.75 0 0 1-1.06 0m-9.193 8.132a.75.75 0 0 0 1.06 1.06l1.062-1.06a.75.75 0 0 0-1.061-1.06zm9.193-1.06a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 0 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 0-1.06M3.404 2.343a.75.75 0 0 0-1.06 1.06l1.06 1.061a.75.75 0 1 0 1.06-1.06z"
                clip-rule="evenodd"></path></svg
            >
          </button>
          <button
            class="theme-switcher__button"
            type="button"
            data-theme-option="dark"
            aria-label="Тёмная тема"
            title="Тёмная тема"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="none"
              viewBox="0 0 16 16"
              ><path
                fill="currentColor"
                fill-rule="evenodd"
                d="M8 13.5a5.5 5.5 0 0 0 2.263-10.514 5.5 5.5 0 0 1-7.278 7.278A5.5 5.5 0 0 0 8 13.5M1.045 8.795a7.001 7.001 0 1 0 7.75-7.75l-.028-.003A7 7 0 0 0 8 1c-.527 0-.59.842-.185 1.18a4 4 0 0 1 .342.322A4 4 0 1 1 2.18 7.814C1.842 7.41 1 7.474 1 8a7 7 0 0 0 .045.794"
                clip-rule="evenodd"></path></svg
            >
          </button>
          <button
            class="theme-switcher__button"
            type="button"
            data-theme-option="system"
            aria-label="Системная тема"
            title="Системная тема"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="none"
              viewBox="0 0 16 16"
              ><path
                fill="currentColor"
                fill-rule="evenodd"
                d="M12 3H4a1.5 1.5 0 0 0-1.5 1.5v4A1.5 1.5 0 0 0 4 10h8a1.5 1.5 0 0 0 1.5-1.5v-4A1.5 1.5 0 0 0 12 3M4 1.5a3 3 0 0 0-3 3v4a3 3 0 0 0 3 3h3.25V13h-2.5a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-2.5v-1.5H12a3 3 0 0 0 3-3v-4a3 3 0 0 0-3-3z"
                clip-rule="evenodd"></path></svg
            >
          </button>
        </div>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <p class="site-footer__copyright">
          © {currentYear} / Михаил Реммеле
        </p>
        <div class="site-footer__socials" aria-label="Социальные ссылки">
          <a
            href="https://t.me/mremmele"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Telegram"
            title="Telegram"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.5 3.5 2.9 10.3c-1.2.47-1.2 1.15-.22 1.45l4.52 1.41L17.74 6.5c.5-.3.96-.14.58.2l-8.55 7.72-.33 4.97c.48 0 .7-.22.98-.49l2.37-2.3 4.92 3.63c.91.5 1.56.24 1.79-.84l2.99-14.07c.34-1.32-.5-1.92-1.99-1.32Z"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/michailRemmele"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.21.68-.48v-1.69c-2.78.6-3.37-1.19-3.37-1.19-.46-1.17-1.12-1.48-1.12-1.48-.91-.62.07-.61.07-.61 1.01.07 1.54 1.03 1.54 1.03.9 1.53 2.37 1.09 2.95.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.92 0-1.08.39-1.96 1.02-2.65-.1-.25-.44-1.27.1-2.64 0 0 .84-.27 2.75 1.01A9.5 9.5 0 0 1 12 6.8c.85 0 1.71.11 2.51.33 1.91-1.28 2.74-1.01 2.74-1.01.55 1.37.21 2.39.11 2.64.64.69 1.02 1.57 1.02 2.65 0 3.82-2.34 4.67-4.57 4.91.36.31.67.92.67 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
              ></path>
            </svg>
          </a>
        </div>
      </footer>
    </div>
    <script>
      type ThemeOption = 'light' | 'dark' | 'system';

      const isThemeOption = (
        value: string | null | undefined
      ): value is ThemeOption =>
        value === 'light' || value === 'dark' || value === 'system';

      const getStoredTheme = (): ThemeOption => {
        const storedTheme = localStorage.getItem('theme');
        return isThemeOption(storedTheme) ? storedTheme : 'system';
      };

      const getCurrentTheme = (): ThemeOption => {
        const currentTheme =
          document.documentElement.getAttribute('data-theme');
        return isThemeOption(currentTheme) ? currentTheme : getStoredTheme();
      };

      const applyTheme = (theme: ThemeOption) => {
        document.documentElement.setAttribute('data-theme', theme);
      };

      const updateActiveState = (theme: ThemeOption) => {
        const buttons = document.querySelectorAll<HTMLButtonElement>(
          '[data-theme-option]'
        );

        buttons.forEach((button) => {
          const isActive = button.dataset.themeOption === theme;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
      };

      const bindThemeButtons = () => {
        const buttons = document.querySelectorAll<HTMLButtonElement>(
          '[data-theme-option]'
        );

        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const selectedTheme = button.dataset.themeOption;
            if (!isThemeOption(selectedTheme)) {
              return;
            }

            applyTheme(selectedTheme);
            localStorage.setItem('theme', selectedTheme);
            updateActiveState(selectedTheme);
          });
        });
      };

      const initThemeSwitcher = () => {
        const initialTheme = getStoredTheme();
        applyTheme(initialTheme);
        updateActiveState(getCurrentTheme());
        bindThemeButtons();
      };

      initThemeSwitcher();
    </script>
  </body>
</html>

---
import '../styles/globals.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/700.css';
import interFont400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import interFont700 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interFont400}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interFont700}
      crossorigin
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-title" href="/">Миша пишет движок</a>
        <div class="theme-switcher" role="group" aria-label="Выбор темы">
          <button
            class="theme-switcher__button"
            type="button"
            data-theme-option="light"
            aria-label="Светлая тема"
            title="Светлая тема"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
            >
              <path
                d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6m0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"
              ></path>
            </svg>
          </button>
          <button
            class="theme-switcher__button"
            type="button"
            data-theme-option="dark"
            aria-label="Тёмная тема"
            title="Тёмная тема"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
            >
              <path
                d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278M4.858 1.311A7.27 7.27 0 0 0 1.025 7.71c0 4.02 3.279 7.276 7.319 7.276a7.32 7.32 0 0 0 5.205-2.162q-.506.063-1.029.063c-4.61 0-8.343-3.714-8.343-8.29 0-1.167.242-2.278.681-3.286"
              ></path>
              <path
                d="M10.794 3.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387a1.73 1.73 0 0 0-1.097 1.097l-.387 1.162a.217.217 0 0 1-.412 0l-.387-1.162A1.73 1.73 0 0 0 9.31 6.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387a1.73 1.73 0 0 0 1.097-1.097zM13.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.16 1.16 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.16 1.16 0 0 0-.732-.732l-.774-.258a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732z"
              ></path>
            </svg>
          </button>
          <button
            class="theme-switcher__button"
            type="button"
            data-theme-option="system"
            aria-label="Системная тема"
            title="Системная тема"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
            >
              <path
                d="M0 4s0-2 2-2h12s2 0 2 2v6s0 2-2 2h-4q0 1 .25 1.5H11a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1h.75Q6 13 6 12H2s-2 0-2-2zm1.398-.855a.76.76 0 0 0-.254.302A1.5 1.5 0 0 0 1 4.01V10c0 .325.078.502.145.602q.105.156.302.254a1.5 1.5 0 0 0 .538.143L2.01 11H14c.325 0 .502-.078.602-.145a.76.76 0 0 0 .254-.302 1.5 1.5 0 0 0 .143-.538L15 9.99V4c0-.325-.078-.502-.145-.602a.76.76 0 0 0-.302-.254A1.5 1.5 0 0 0 13.99 3H2c-.325 0-.502.078-.602.145"
              ></path>
            </svg>
          </button>
        </div>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <p class="site-footer__copyright">
          © {currentYear} / Михаил Реммеле
        </p>
        <div class="site-footer__socials" aria-label="Социальные ссылки">
          <a
            href="https://t.me/mremmele"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Telegram"
            title="Telegram"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.5 3.5 2.9 10.3c-1.2.47-1.2 1.15-.22 1.45l4.52 1.41L17.74 6.5c.5-.3.96-.14.58.2l-8.55 7.72-.33 4.97c.48 0 .7-.22.98-.49l2.37-2.3 4.92 3.63c.91.5 1.56.24 1.79-.84l2.99-14.07c.34-1.32-.5-1.92-1.99-1.32Z"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/michailRemmele"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.21.68-.48v-1.69c-2.78.6-3.37-1.19-3.37-1.19-.46-1.17-1.12-1.48-1.12-1.48-.91-.62.07-.61.07-.61 1.01.07 1.54 1.03 1.54 1.03.9 1.53 2.37 1.09 2.95.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.92 0-1.08.39-1.96 1.02-2.65-.1-.25-.44-1.27.1-2.64 0 0 .84-.27 2.75 1.01A9.5 9.5 0 0 1 12 6.8c.85 0 1.71.11 2.51.33 1.91-1.28 2.74-1.01 2.74-1.01.55 1.37.21 2.39.11 2.64.64.69 1.02 1.57 1.02 2.65 0 3.82-2.34 4.67-4.57 4.91.36.31.67.92.67 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
              ></path>
            </svg>
          </a>
        </div>
      </footer>
    </div>
    <script>
      type ThemeOption = 'light' | 'dark' | 'system';

      const isThemeOption = (
        value: string | null | undefined
      ): value is ThemeOption =>
        value === 'light' || value === 'dark' || value === 'system';

      const getStoredTheme = (): ThemeOption => {
        const storedTheme = localStorage.getItem('theme');
        return isThemeOption(storedTheme) ? storedTheme : 'system';
      };

      const getCurrentTheme = (): ThemeOption => {
        const currentTheme =
          document.documentElement.getAttribute('data-theme');
        return isThemeOption(currentTheme) ? currentTheme : getStoredTheme();
      };

      const applyTheme = (theme: ThemeOption) => {
        document.documentElement.setAttribute('data-theme', theme);
      };

      const updateActiveState = (theme: ThemeOption) => {
        const buttons = document.querySelectorAll<HTMLButtonElement>(
          '[data-theme-option]'
        );

        buttons.forEach((button) => {
          const isActive = button.dataset.themeOption === theme;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
      };

      const bindThemeButtons = () => {
        const buttons = document.querySelectorAll<HTMLButtonElement>(
          '[data-theme-option]'
        );

        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const selectedTheme = button.dataset.themeOption;
            if (!isThemeOption(selectedTheme)) {
              return;
            }

            applyTheme(selectedTheme);
            localStorage.setItem('theme', selectedTheme);
            updateActiveState(selectedTheme);
          });
        });
      };

      const initThemeSwitcher = () => {
        const initialTheme = getStoredTheme();
        applyTheme(initialTheme);
        updateActiveState(getCurrentTheme());
        bindThemeButtons();
      };

      initThemeSwitcher();
    </script>
  </body>
</html>
